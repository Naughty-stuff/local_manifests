<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <remote
        name="manipvlator"
        fetch="https://github.com/Naughty-stuff/" />
    <remote
        name="gitlab"
        fetch="https://gitlab.com/unsatifsed27" />
    <remote
        name="hw"
        fetch="https://github.com/PixelOS-AOSP/hardware_xiaomi" />
    <remote
        name="kernel"
        fetch="https://github.com/manipvlator/los_kernel_xiaomi_sm6150" />

    <!-- Device -->
    <project
        path="device/xiaomi/sweet"
        name="device_xiaomi_sweet"
        remote="manipvlator"
        revision="lineage-20" />

    <project
        path="device/xiaomi/sm6150-common"
        name="android_device_xiaomi_sm6150-common"
        remote="manipvlator"
        revision="lineage-20" />

    <!-- Vendor -->
    <project
        path="vendor/xiaomi/sm6150-common"
        name="android_vendor_xiaomi_sm6150-common"
        remote="manipvlator"
        revision="lineage-20" />

    <project
        path="vendor/xiaomi/sweet"
        name="vendor_xiaomi_sweet"
        remote="manipvlator"
        revision="lineage-20" />

    <!-- Hardware Xiaomi -->
    <project
        path="hardware/xiaomi"
        name="hardware_xiaomi"
        remote="hw"
        revision="thirteen" />

    <!-- Kernel -->
    <project
        path="kernel/xiaomi/sm6150"
        name="los_kernel_xiaomi_sm6150"
        remote="kernel"
        revision="stable" />
    
    <project
        path="vendor/lineage-priv/keys"
        name="minami-sign"
        remote="manipvlator"
        revision="keys" />

    <!-- MIUI Camera -->
    <project
        path="vendor/xiaomi/miuicamera-sweet"
        name="miuicamera"
        remote="gitlab"
        revision="leica" />
    
    <project
        path="packages/apps/ViPER4AndroidFX"
        name="packages_apps_ViPER4AndroidFX"
        remote="manipvlator"
        revision="17" />
    
    <project
        path="vendor/dolby"
        name="sony_vendor_dolby"
        remote="manipvlator"
        revision="13" />
    
</manifest>
